/* test/good/good12.tpc */
/* Test coverage: %, /, !, - unaire */
int main(void) {
    int a; int b;
    a = 10;
    b = 3;
    
    /* Test division et modulo */
    a = a / b; 
    b = a % 2;

    /* Test négation booléenne (!) */
    if (!b) {
        /* Test moins unaire (-1) */
        return -1;
    }
    return 0;
}