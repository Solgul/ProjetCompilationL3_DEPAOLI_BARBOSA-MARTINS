/* Test : Shadowing sur 3 niveaux */
int x; /* Niveau 0 */

int main(void) {
    int val;
    x = 1;
    
    if (1) {
        int x; /* Niveau 1 */
        x = 2;
        if (1) {
            int x; /* Niveau 2 */
            x = 3;
            val = x; /* Doit valoir 3 */
        }
        val = val + x; /* 3 + 2 = 5 */
    }
    val = val + x; /* 5 + 1 = 6 */
    
    return val;
}