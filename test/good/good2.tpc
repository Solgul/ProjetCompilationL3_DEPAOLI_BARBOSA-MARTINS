//test while(), if(), return;, char, 
void affiche_le_premier_C(char tank){
  int i; 
  char assaut;
  i = 0;
  assaut = tank;
  while(assaut != EOF){
    assaut = tank;
    if(assaut == 'c'){
      return;
    }
    i = i + 1;
  }
}

int main(void){
  char tank; tank= 's';
  affiche_le_premier_C(tank);
}
