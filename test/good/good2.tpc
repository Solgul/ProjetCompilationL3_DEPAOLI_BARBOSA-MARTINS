//test while(), if(), return;, char, 
void affiche_le_premier_C(char* tank){
  int i; i = 0; char assaut;
  while((assaut = tank[i]) != EOF){
    if(assaut == 'c'){
      printf("%d\n", i);
      return;
    }
    i = i + 1;
  }
}

int main(void){
  char* tank; tank= "salut c'est michel";
  affiche_le_premier_C(tank);
}
