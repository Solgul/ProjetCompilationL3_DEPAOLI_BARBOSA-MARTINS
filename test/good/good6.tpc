/* Test ciblé : Opérateurs de comparaison et Modulo isolés */
int main(void) {
    int x;
    int a, b;
    a = 10;
    b = 3;

    /* 1. Test du Modulo (DIVSTAR) avec constantes et variables */
    x = 10 % 3;       /* Force la réduction : NUM % NUM */
    x = a % b;        /* Force la réduction : IDENT % IDENT */
    x = (a + 1) % 2;  /* Force la réduction : (Exp) % NUM */

    /* 2. Test des Comparaisons (ORDER) en affectation */
    /* En C (et TPC), une comparaison vaut 0 ou 1, on peut l'assigner */
    
    x = a < b;   /* Test < */
    x = a > b;   /* Test > */
    x = a <= 10; /* Test <= */
    x = b >= 3;  /* Test >= */

    return x;
}